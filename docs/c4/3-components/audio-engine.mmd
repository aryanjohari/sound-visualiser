%% Prefer C4Component. Flowchart equivalent follows as comments.

C4Component
  title Components — Audio engine

  Container_Boundary(ae, "audio-engine") {
    Component(srcMic, "Microphone source", "MediaStreamAudioSourceNode", "getUserMedia audio track")
    Component(srcEl, "Element source", "MediaElementAudioSourceNode", "Local file blob URL or demo / URL")
    Component(ctx, "AudioContext lifecycle", "Web Audio", "Create, resume, suspend; teardown tracks and blob URLs")
    Component(meyda, "Meyda analyzer", "rms + powerSpectrum", "bufferSize 512, hopSize 256")
    Component(flux, "Spectral flux", "hand-rolled", "Positive per-bin deltas, log10 compress — Meyda spectralFlux avoided")
    Component(bands, "Band energies", "TypeScript", "lowpass / bass / mid / high via hzPerBin")
    ComponentDb(latest, "Latest AudioFeatures", "in-memory", "Overwritten each Meyda callback; no queue")
  }

  Rel(srcMic, ctx, "Feeds")
  Rel(srcEl, ctx, "Feeds")
  Rel(ctx, meyda, "Attaches analyzer")
  Rel(meyda, flux, "powerSpectrum frames")
  Rel(meyda, bands, "powerSpectrum frames")
  Rel(meyda, latest, "rms")
  Rel(flux, latest, "spectralFlux")
  Rel(bands, latest, "band fields")

