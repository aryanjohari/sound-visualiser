%% Prefer C4Component. Flowchart equivalent follows as comments.

C4Component
  title Components — VJ scene

  Container_Boundary(scene, "vj-scene") {
    Component(router, "VJScene mode router", "src/webgl/Scene.ts", "Serialises mode changes; webcam attach/detach")
    Component(env, "EnvironmentLayers", "fluid sphere GLSL", "Bass warp + high lightning")
    Component(anchor, "AnchorLayer", "torus-knot particles", "Curl-noise deformation")
    Component(lights, "LightingLayer", "Three.js lights", "Centre flash from lightningFlash")
    Component(director, "Director", "GSAP camera", "Orbit, FOV, kick shake, Z-dolly punch")
    Component(post, "PostProcessing", "EffectComposer", "Custom chromatic aberration — Cinematic only")
    Component(live, "LiveFeedLayer", "webcam shader", "Frozen reference look; direct canvas blit")
    Component(acid, "AcidFeedLayer", "FBO feedback", "header + liveFeedCommon + body; warp-aligned trails")
    ComponentDb(fbo, "Ping-pong FBOs", "WebGLRenderTarget A/B", "Acid feedback buffers")
  }

  Rel(router, env, "Always updates 3D layers")
  Rel(router, anchor, "Always updates 3D layers")
  Rel(router, lights, "Always updates 3D layers")
  Rel(router, director, "Always updates 3D layers")
  Rel(router, post, "Cinematic render path")
  Rel(router, live, "Live mode render")
  Rel(router, acid, "Acid mode render")
  Rel(acid, fbo, "Read / write alternate")
  Rel(fbo, acid, "Previous frame sample")

