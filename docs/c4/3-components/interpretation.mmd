%% Prefer C4Component. Flowchart equivalent follows as comments.

C4Component
  title Components — Interpretation ladder

  Container_Boundary(interp, "interpretation") {
    Component(loop, "Loop sequencer", "src/webgl/Loop.ts", "Fixed per-frame order; owns MoodAnalyzer + BeatSync")
    Component(sm, "StateManager", "src/webgl/StateManager.ts", "rave to cinematic energy + lightningFlash; peak-relative EMAs")
    Component(mood, "MoodAnalyzer", "src/webgl/MoodAnalyzer.ts", "calm / groove / intense weights (partition of unity)")
    Component(beat, "BeatSync", "src/webgl/BeatSync.ts", "Onset pick, 60-180 BPM vote, PLL phase, confidence")
    ComponentDb(vjstate, "VJState", "per frame", "Merged energy + mood + beat for the scene")
  }

  Rel(loop, sm, "1. update(features, dt)")
  Rel(loop, mood, "2. update(features, baseState, dt)")
  Rel(loop, beat, "3. update(features, baseState, dt, syncMode)")
  Rel(sm, mood, "Passes rave / averages / lightningFlash")
  Rel(sm, beat, "Passes rmsAvg for silence gate")
  Rel(sm, vjstate, "Energy fields")
  Rel(mood, vjstate, "mood + moodWeights")
  Rel(beat, vjstate, "beat")
  Rel(loop, vjstate, "Assembles and publishes")

