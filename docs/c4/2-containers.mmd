%% Prefer Mermaid C4Container. If a renderer rejects C4 syntax, use the flowchart
%% equivalent at the bottom (uncomment that block).

C4Container
  title Containers — Sound Visualiser (single browser SPA)

  Person(operator, "Operator", "Plays a track, nudges a look, may keep a clip")

  System_Boundary(spa, "Sound Visualiser — one static SPA in the browser tab") {
    Container(glassUi, "Glass controls", "TypeScript / DOM", "Source buttons, look / sync / axes, JSON and Keep controls, status line")
    ContainerDb(demoAsset, "Bundled demo track", "static mp3", "Shipped /freetibet.mp3 with the build")
    Container(audioEngine, "Audio engine", "Web Audio + Meyda", "Mic / file / URL sources, RMS, bands, spectral flux")
    ContainerDb(featureSnapshot, "Latest audio snapshot", "in-memory struct", "Pull-model handoff; overwritten, never queued")
    Container(interpretation, "Interpretation ladder", "TypeScript", "Energy, mood weights, beat / confidence")
    Container(lookDocument, "Look document", "JSON schema + apply", "schemaVersion 1; look, sync, axes; one writer")
    Container(renderLoop, "Frame loop", "requestAnimationFrame", "Orders analysers, camera impulses, scene update + render")
    Container(videoCapture, "Webcam capture", "getUserMedia", "Hidden video to Three.js VideoTexture (Live / Acid only)")
    Container(vjScene, "VJ scene", "Three.js + GLSL", "Mode routing and visual layers")
    Container(webglCanvas, "Full-screen canvas", "HTML canvas #webgl", "Display output")
    Container(keep, "Keep", "MediaRecorder", "≤30s canvas + audio; HUD out; local download")
  }

  Rel(operator, glassUi, "Uses")
  Rel(glassUi, audioEngine, "Starts mic, file, or demo")
  Rel(demoAsset, audioEngine, "Played as /freetibet.mp3")
  Rel(glassUi, lookDocument, "Writes look, sync, and axes; download or reload JSON")
  Rel(lookDocument, vjScene, "Applies lookId and axis multipliers")
  Rel(lookDocument, renderLoop, "Applies sync policy")
  Rel(glassUi, videoCapture, "Starts camera for Live / Acid")
  Rel(audioEngine, featureSnapshot, "Overwrites latest features")
  Rel(renderLoop, featureSnapshot, "Reads snapshot each frame")
  Rel(featureSnapshot, interpretation, "Feeds analysers")
  Rel(interpretation, renderLoop, "Assembles VJState")
  Rel(renderLoop, vjScene, "update + render")
  Rel(videoCapture, vjScene, "Attaches VideoTexture when Live / Acid")
  Rel(vjScene, webglCanvas, "Draws WebGL")
  Rel(glassUi, keep, "Starts and stops Keep")
  Rel(webglCanvas, keep, "Canvas stream (HUD not in pixels)")
  Rel(audioEngine, keep, "Audio tap of the current source")
  Rel(lookDocument, keep, "Look JSON saved with the clip")
  Rel(keep, operator, "Local ≤30s clip; nothing uploaded")

